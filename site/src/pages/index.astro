<script>
	document.documentElement.classList.remove('js-reveal');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduced) {
		document.documentElement.classList.add('js-reveal');

		const h1 = document.querySelector('[data-reveal-words]');
		if (h1) {
			const wrap = (node: Node) => {
				if (node.nodeType === Node.TEXT_NODE) {
					const frag = document.createDocumentFragment();
					(node.textContent || '').split(/(\s+)/).forEach((part) => {
						if (/^\s+$/.test(part) || part === '') {
							frag.appendChild(document.createTextNode(part));
						} else {
							const s = document.createElement('span');
							s.className = 'w';
							s.textContent = part;
							frag.appendChild(s);
						}
					});
					node.parentNode?.replaceChild(frag, node);
				}
			};
			Array.from(h1.childNodes).forEach((n) => {
				if (n.nodeType === Node.ELEMENT_NODE) {
					Array.from(n.childNodes).forEach(wrap);
				} else {
					wrap(n);
				}
			});
			requestAnimationFrame(() => {
				h1.querySelectorAll('.w').forEach((w, i) => {
					(w as HTMLElement).style.transitionDelay = `${i * 0.06}s`;
					requestAnimationFrame(() => w.classList.add('in'));
				});
			});
		}

		const revealRows = document.querySelectorAll('main .row:not(.hero)');
		const targets: HTMLElement[] = [];
		revealRows.forEach((row) => {
			row.querySelectorAll(':scope > .cells').forEach((cells) => {
				const cs = Array.from(cells.querySelectorAll(':scope > .c')) as HTMLElement[];
				cs.forEach((c, i) => {
					c.classList.add('scroll-reveal');
					c.style.setProperty('--sr-delay', `${Math.min(i * 0.08, 0.24)}s`);
					targets.push(c);
				});
			});
		});
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add('sr-in');
						io.unobserve(e.target);
					}
				}
			},
			{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
		);
		if ('IntersectionObserver' in window) {
			targets.forEach((c) => io.observe(c));
			const revealStuck = () => {
				if (document.hidden) return;
				targets.forEach((c) => {
					if (c.classList.contains('sr-in')) return;
					const r = c.getBoundingClientRect();
					if (r.top < window.innerHeight && r.bottom > 0) c.classList.add('sr-in');
				});
			};
			setTimeout(revealStuck, 3000);
			setInterval(revealStuck, 5000);
		} else {
			targets.forEach((c) => c.classList.add('sr-in'));
		}
	}

	document.addEventListener('visibilitychange', () => {
		document.documentElement.classList.toggle('rail-paused', document.hidden);
	});

	document.querySelectorAll('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const text = btn.getAttribute('data-copy') || '';
			try {
				await navigator.clipboard.writeText(text);
				btn.classList.add('done');
				btn.textContent = 'copied';
				setTimeout(() => {
					btn.classList.remove('done');
					btn.textContent = 'copy';
				}, 1400);
			} catch {
				/* clipboard unavailable */
			}
		});
	});
</script>

