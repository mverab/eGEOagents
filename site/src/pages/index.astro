---
const title = 'E-GEO — Open-Source GEO & AEO Toolkit';
const description =
	'E-GEO — open-source Generative Engine Optimization (GEO) & Answer Engine Optimization (AEO) toolkit (Python CLI + Claude Code skills), based on published GEO research (arXiv:2511.20867).';

const orgSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'E-GEO',
	url: 'https://egeoagents.com',
	sameAs: [
		'https://github.com/mverab/eGEOagents',
		'https://arxiv.org/abs/2511.20867',
	],
	founder: {
		'@type': 'Person',
		name: 'Miguel Vera',
		sameAs: ['https://github.com/mverab'],
	},
});

const softwareSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'E-GEO',
	description,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Linux, macOS, Windows',
	license: 'https://opensource.org/licenses/MIT',
	codeRepository: 'https://github.com/mverab/eGEOagents',
	citation: 'https://arxiv.org/abs/2511.20867',
	url: 'https://egeoagents.com',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	author: {
		'@type': 'Person',
		name: 'Miguel Vera',
		sameAs: ['https://github.com/mverab'],
	},
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://egeoagents.com/" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://egeoagents.com/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;800&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json" set:html={orgSchema} />
		<script type="application/ld+json" set:html={softwareSchema} />
	</head>
	<body>
		<header class="row hd">
			<div class="cells">
				<a class="c brand" href="/">E-GEO®</a>
				<nav class="c nav" aria-label="Primary">
					<a href="/docs/getting-started/">Docs</a>
					<a href="/concepts/what-is-geo/">What is GEO?</a>
					<a href="/compare/geo-tools-2026/">Compare</a>
					<a href="https://github.com/mverab/eGEOagents">GitHub</a>
				</nav>
				<span class="c meta">Open source / MIT</span>
			</div>
		</header>

		<main>
			<section class="row hero" aria-labelledby="hero-h">
				<div class="cells">
					<p class="c label">Generative Engine Optimization — for the answer economy</p>
				</div>
				<div class="cells hero-split">
					<div class="c hero-left">
						<h1 id="hero-h" data-reveal-words>
							Your customers stopped searching. They started{' '}
							<span class="asked">asking.</span>
						</h1>
						<p class="sub">
							E-GEO analyzes, rewrites, and schema-marks your pages so answer engines
							cite you. <b>ChatGPT. Perplexity. Gemini. Claude.</b> Be the source they
							name.
						</p>
						<div class="cta-group">
							<a class="primary" href="/docs/getting-started/"
								>get started <span aria-hidden="true">→</span></a
							>
							<a class="ghost" href="https://github.com/mverab/eGEOagents"
								>★ star on github</a
							>
							<a class="txt" href="https://arxiv.org/abs/2511.20867"
								>read the research ↗</a
							>
						</div>
						<div class="stats" aria-label="Project stats">
							<span><b>147★</b> github</span>
							<span><b>42</b> forks</span>
							<span><b>MIT</b> license</span>
							<span><b>arXiv</b> 2511.20867</span>
						</div>
					</div>
					<figure
						class="c field"
						aria-label="Live diagram: questions flow into one generated answer, which cites a small set of sources — the highlighted node is the cited source"
					>
						<svg
							id="citation-field"
							data-motion-loop="raf"
							viewBox="0 0 960 420"
							role="img"
							aria-hidden="false"
						>
							<title>The citation field</title>
							<desc
								>Questions enter from the left, resolve into one answer, and
								the answer cites a marked source node.</desc
							>
							<text x="54" y="34">Questions in</text>
							<text x="906" y="34" text-anchor="end">Sources cited</text>
							<text x="480" y="286" text-anchor="middle">One answer</text>
							<text x="906" y="250" text-anchor="end">[1] yoursite.com — cited</text>

							<path class="flow" d="M 66 60 H 240 V 186 H 438" />
							<path class="flow" d="M 66 150 H 280 V 202 H 438" />
							<path class="flow" d="M 66 270 H 320 V 218 H 438" />
							<path class="flow" d="M 66 330 H 360 V 234 H 438" />
							<path class="flow" d="M 522 186 H 660 V 120 H 882" />
							<path class="flow" d="M 522 234 H 660 V 300 H 882" />
							<path class="wire" d="M 522 210 H 876" />
							<path
								id="cite-route"
								d="M 66 150 H 280 V 202 H 480 V 210 H 876"
							/>

							<rect class="qn" x="54" y="54" width="12" height="12" />
							<rect class="qn" x="54" y="144" width="12" height="12" />
							<rect class="qn" x="54" y="264" width="12" height="12" />
							<rect class="qn" x="54" y="324" width="12" height="12" />

							<g id="tok-1" class="tok" transform="translate(240,120)" data-follow="0">
								<rect x="-5" y="-5" width="10" height="10" />
							</g>
							<g id="tok-2" class="tok" transform="translate(200,270)" data-follow="2">
								<rect x="-5" y="-5" width="10" height="10" />
							</g>
							<g id="tok-3" class="tok" transform="translate(660,240)" data-follow="5">
								<rect x="-5" y="-5" width="10" height="10" />
							</g>

							<rect id="answer-node" x="438" y="168" width="84" height="84" />
							<line id="scan" x1="446" y1="210" x2="514" y2="210" />

							<rect class="qn" x="882" y="114" width="12" height="12" />
							<rect class="qn" x="882" y="294" width="12" height="12" />
							<rect id="pulse-ring" x="868" y="186" width="48" height="48" />
							<rect id="cited-node" x="876" y="194" width="32" height="32" />
						</svg>
						<figcaption class="field-caption">
							<span class="lbl">The citation field</span>
							<p>
								Millions of questions stream into an answer engine. It compresses
								them into a single reply and names only a handful of sources. GEO
								is the work of becoming the marked node — the source the answer
								cites.
							</p>
						</figcaption>
					</figure>
				</div>
			</section>

			<aside class="row engine-rail" id="engine-rail" aria-labelledby="rail-lbl">
				<div class="cells">
					<p class="c rail-label" id="rail-lbl">
						Answer engines / the surfaces where sources get named
					</p>
					<div class="c rail-clip">
						<ul class="rail-track">
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
						</ul>
						<ul class="rail-track" aria-hidden="true">
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
							<li>ChatGPT</li><li>Perplexity</li><li>Gemini</li><li>Claude</li>
						</ul>
					</div>
				</div>
			</aside>

			<section class="row qa" aria-label="An AI answer citing your site" id="answer-card">
				<div class="cells">
					<div class="c q">
						<span class="lbl">The question</span>
						<p class="qtext">“Which product should I actually buy?”</p>
					</div>
					<div class="c a">
						<span class="lbl">The answer — and its source</span>
						<p>
							Answer engines compress the whole web into one reply with a handful of
							citations. Rank doesn't exist there. Either you are quoted, or you are
							invisible.
						</p>
						<p class="cite"><span class="one">[1]</span> yoursite.com — cited</p>
					</div>
				</div>
			</section>

			<section class="row shift" aria-labelledby="shift-h">
				<div class="cells">
					<h2 class="c" id="shift-h">The shift</h2>
					<div class="c body">
						<p class="big">
							The front page of the web is no longer a list of ten blue links. It is
							a single generated answer, and the only real estate left is the
							citation inside it. Traffic now belongs to the sources answer engines
							trust enough to quote.
						</p>
						<p class="entity">
							E-GEO — open-source Generative Engine Optimization (GEO) &amp; Answer
							Engine Optimization (AEO) toolkit (Python CLI + Claude Code skills),
							based on published GEO research (arXiv:2511.20867).
						</p>
						<div class="answer-block" id="answer-block">
							<span class="lbl">What E-GEO does, in one block</span>
							<p>
								E-GEO is an open-source toolkit that makes web content get cited by
								AI answer engines such as ChatGPT, Perplexity, Gemini, and Claude.
								It analyzes pages against ten research-derived GEO features,
								rewrites content so every claim is quotable while preserving brand
								voice and facts, and generates JSON-LD schema so engines attribute
								the source. It ships as a Python CLI with Claude Code skills,
								includes a reproducible evaluation harness you can run offline, and
								a continuous monitoring loop that watches pages over time. It is
								MIT-licensed and based on published GEO research
								(arXiv:2511.20867), building on Princeton's KDD 2024 study.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="row how" aria-labelledby="how-h">
				<div class="cells">
					<h2 class="c" id="how-h">How it<br />works</h2>
					<ol class="c steps">
						<li>
							<b>01 Analyze</b>
							<span
								>Point E-GEO at a page. It scores it against the ten features
								answer engines reward — structure, statistics, quotable claims,
								clarity.</span
							>
						</li>
						<li>
							<b>02 Rewrite</b>
							<span
								>It restructures the content for citation. Your voice stays. Your
								facts stay. Every claim becomes liftable.</span
							>
						</li>
						<li>
							<b>03 Get cited</b>
							<span
								>Schema goes on, the loop keeps watching, and when an engine
								answers your customer's question — you are the source it names.</span
							>
						</li>
					</ol>
				</div>
			</section>

			<section class="row caps" aria-labelledby="caps-h">
				<div class="cells caps-head">
					<h2 class="c" id="caps-h">What's in the box</h2>
				</div>
				<div class="cells caps-grid">
					<div class="c cap">
						<b>10-feature GEO scoring</b>
						<p>Every page measured against the research-derived features engines reward.</p>
					</div>
					<div class="c cap">
						<b>Content rewriting</b>
						<p>Copy-paste-ready rewrites — brand voice preserved, facts untouched.</p>
					</div>
					<div class="c cap">
						<b>JSON-LD schema generation</b>
						<p>Structured markup for every page, so engines attribute, not just read.</p>
					</div>
					<div class="c cap">
						<b>Reproducible evaluation harness</b>
						<p>Verify the rewriter's effect yourself — offline, deterministic, CI-ready.</p>
					</div>
					<div class="c cap">
						<b>Continuous monitoring loop</b>
						<p>geo-loop watches your pages over time with bounded, scheduled runs.</p>
					</div>
					<div class="c cap">
						<b>Claude Code skills</b>
						<p>The whole pipeline, installable as skills into your Claude Code setup.</p>
					</div>
				</div>
			</section>

			<section class="row compare" aria-labelledby="cmp-h">
				<div class="cells">
					<div class="c cmp-intro">
						<h2 id="cmp-h">The honest comparison</h2>
						<p>
							Last verified: 2026-08-05. A GEO tool caught inflating itself loses
							the only thing that matters: being a source engines can trust. Full
							roundup: <a href="/compare/geo-tools-2026/">open-source GEO tools in 2026</a> ·
							head-to-head: <a href="/compare/e-geo-vs-geo-optimizer-skill/">E-GEO vs geo-optimizer-skill</a>.
						</p>
					</div>
				</div>
				<div class="cells table-wrap">
					<table class="c">
						<thead>
							<tr>
								<th scope="col">Tool</th>
								<th scope="col">Type</th>
								<th scope="col">Best for</th>
								<th scope="col">Stars</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>geo-optimizer-skill (Auriti-Labs)</td>
								<td>CLI + Python lib + MCP + Astro integration</td>
								<td>Broad site audits (0–100, 47 methods)</td>
								<td>~644</td>
							</tr>
							<tr class="us">
								<td>E-GEO</td>
								<td>Python CLI + Claude Code skills + MCP-based validation</td>
								<td>Full rewrite pipeline, reproducible evaluation, continuous loops</td>
								<td>147</td>
							</tr>
							<tr>
								<td>GEO (original research repo)</td>
								<td>Research code</td>
								<td>Reproducing the Princeton KDD 2024 experiments</td>
								<td>—</td>
							</tr>
							<tr>
								<td>Awesome GEO</td>
								<td>Curated list</td>
								<td>Discovering the ecosystem</td>
								<td>—</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section class="row install" aria-labelledby="inst-h">
				<div class="cells">
					<h2 class="c" id="inst-h">Install</h2>
					<div class="c chips">
						<div class="chip">
							<code>pip install egeo</code>
							<button type="button" data-copy="pip install egeo">copy</button>
						</div>
						<div class="chip">
							<code>npx skills add https://github.com/mverab/eGEOagents</code>
							<button
								type="button"
								data-copy="npx skills add https://github.com/mverab/eGEOagents"
								>copy</button
							>
						</div>
						<p class="chip-note">
							Then read the <a href="/docs/getting-started/">getting started guide</a>
							and the <a href="/docs/cli/">CLI reference</a>. Questions? The
							<a href="/docs/faq/">FAQ</a> is short and honest.
						</p>
					</div>
				</div>
			</section>

			<section class="row final" aria-labelledby="final-h">
				<div class="cells">
					<h2 class="c" id="final-h">Be the source<br />they <span class="asked">name.</span></h2>
				</div>
				<div class="cells cta">
					<a class="c primary" href="/docs/getting-started/"
						>get started <span aria-hidden="true">→</span></a
					>
					<a class="c ghost" href="https://github.com/mverab/eGEOagents"
						>★ star on github</a
					>
					<a class="c txt" href="https://arxiv.org/abs/2511.20867"
						>read the research ↗</a
					>
				</div>
			</section>
		</main>

		<footer class="row ft">
			<div class="cells">
				<div class="c ft-col">
					<b>E-GEO®</b>
					<span>147★ · 42 forks · mit · arxiv:2511.20867</span>
				</div>
				<nav class="c ft-col" aria-label="Documentation">
					<b>Docs</b>
					<a href="/docs/getting-started/">Getting started</a>
					<a href="/docs/cli/">CLI reference</a>
					<a href="/docs/faq/">FAQ</a>
				</nav>
				<nav class="c ft-col" aria-label="Concepts and comparisons">
					<b>Learn</b>
					<a href="/concepts/what-is-geo/">What is GEO?</a>
					<a href="/compare/geo-tools-2026/">GEO tools in 2026</a>
					<a href="/compare/e-geo-vs-geo-optimizer-skill/">vs geo-optimizer-skill</a>
				</nav>
				<nav class="c ft-col" aria-label="External links">
					<b>Elsewhere</b>
					<a href="https://github.com/mverab/eGEOagents">GitHub</a>
					<a href="https://arxiv.org/abs/2511.20867">arXiv:2511.20867</a>
					<a href="https://github.com/mverab/eGEOagents/blob/main/LICENSE">MIT license</a>
				</nav>
			</div>
		</footer>
	</body>
</html>


<style>
	:root {
		--white: #ffffff;
		--black: #000000;
		--grey: #6b6b6b;
		--flu: #d4ff00;
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	html {
		background: var(--white);
	}
	body {
		background: var(--white);
		color: var(--black);
		font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
		line-height: 1.4;
		border-top: 2px solid var(--black);
	}
	a {
		color: inherit;
	}
	.row {
		border-bottom: 2px solid var(--black);
	}
	.cells {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		max-width: 1440px;
		margin: 0 auto;
	}
	.cells + .cells {
		border-top: 2px solid var(--black);
	}
	.c {
		border-left: 2px solid var(--black);
	}
	.c:first-child {
		border-left: none;
	}

	/* header */
	.hd .c {
		padding: 18px 24px;
		font-size: 0.8rem;
		font-weight: 600;
	}
	.hd .brand {
		grid-column: span 3;
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.hd .nav {
		grid-column: span 6;
		display: flex;
		gap: 28px;
		flex-wrap: wrap;
	}
	.hd .nav a {
		text-decoration: none;
	}
	.hd .nav a:hover {
		background: var(--black);
		color: var(--white);
	}
	.hd .meta {
		grid-column: span 3;
		text-align: right;
		color: var(--grey);
		font-weight: 500;
	}

	/* hero */
	.label {
		grid-column: 1 / -1;
		padding: 14px 24px;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}
	.hero {
		display: flex;
		flex-direction: column;
		min-height: clamp(720px, calc(100svh - 72px), 860px);
	}
	.hero .cells {
		width: 100%;
	}
	.hero .hero-split {
		flex: 1 1 auto;
	}
	h1 {
		font-weight: 800;
		font-size: clamp(3rem, 5.5vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.045em;
		text-transform: uppercase;
		max-width: 18ch;
	}
	.hero-split .hero-left {
		grid-column: span 7;
		padding: 48px 24px 56px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 32px;
	}
	.asked {
		background: var(--flu);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		padding: 0 0.06em;
	}
	h1 .w {
		display: inline-block;
		will-change: transform, filter;
	}
	.js-reveal h1 .w {
		opacity: 0;
		transform: translateY(40px);
		filter: blur(20px);
	}
	.js-reveal h1 .w.in {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
		transition:
			opacity 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
			transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
			filter 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.sub {
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		max-width: 42ch;
	}
	.sub b {
		font-weight: 800;
	}
	.stats {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		color: var(--grey);
	}
	.stats b {
		color: var(--black);
	}

	/* hero cta group */
	.cta-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
	}
	.cta-group a {
		text-decoration: none;
		font-weight: 800;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		padding: 14px 22px;
	}
	.cta-group .primary {
		background: var(--black);
		color: var(--white);
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.cta-group .primary:hover {
		background: var(--flu);
		color: var(--black);
	}
	.cta-group .ghost {
		border: 2px solid var(--black);
		padding: 12px 20px;
	}
	.cta-group .ghost:hover {
		background: var(--black);
		color: var(--white);
	}
	.cta-group .txt {
		font-weight: 600;
		color: var(--grey);
		font-size: 0.85rem;
		text-transform: none;
		padding: 0;
	}
	.cta-group .txt:hover {
		color: var(--black);
	}

	/* citation field */
	.field-caption {
		margin-top: 18px;
		padding-top: 18px;
