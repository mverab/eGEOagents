# Copy to .env (never commit .env). Read by compose.yml.

# LLM used for the one free section rewrite (OpenAI-compatible API).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
REWRITER_MODEL=gpt-4o

# Limits (defaults shown). See openspec/changes/add-public-url-audit/design.md D6.
AUDIT_IP_DAILY_LIMIT=5
AUDIT_LLM_DAILY_CAP=200
AUDIT_CACHE_TTL_S=3600
AUDIT_REPORT_TTL_S=86400
AUDIT_ALLOWED_ORIGINS=https://egeoagents.com

# Cloudflare Tunnel token for api.egeoagents.com -> http://audit:8787
CLOUDFLARE_TUNNEL_TOKEN=
